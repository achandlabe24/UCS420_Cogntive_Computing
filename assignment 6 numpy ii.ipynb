   "source": [
    "# UCS420: Cognitive Computing\n",
    "# Assignment 6 - Numpy-II"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "# Given sensor readings\n",
    "temperature = np.array([25, 28, 31, 35, 38, 27, 33, 40])\n",
    "\n",
    "# a. Add 2°C to every reading using vectorization\n",
    "adjusted_temp = temperature + 2\n",
    "print(\"a. Adjusted Temperatures (+2°C):\", adjusted_temp)\n",
    "\n",
    "# b. Convert all temperatures from Celsius to Fahrenheit using F = (9/5)*C + 32\n",
    "fahrenheit = (9 / 5) * temperature + 32\n",
    "print(\"b. Temperatures in Fahrenheit:\", fahrenheit)\n",
    "\n",
    "# c. Identify all readings greater than 32°C using Boolean indexing\n",
    "high_temps = temperature[temperature > 32]\n",
    "print(\"c. Readings > 32°C:\", high_temps)\n",
    "\n",
    "# d. Count how many readings exceed 32°C\n",
    "count_high = np.sum(temperature > 32)\n",
    "print(\"d. Count of readings > 32°C:\", count_high)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**e. Explanation:** Vectorization delegates operations to highly optimized C-compiled routines under the hood, eliminating Python interpreter overhead and explicit loop iteration[cite: 2]. Boolean indexing evaluates conditions across the entire array simultaneously in compiled machine code, returning filtered elements instantly without manual conditional traversal[cite: 2]."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q2. The following matrix represents the number of daily steps recorded by four users over three days:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "steps = np.array([\n",
    "    [5000, 6200, 7100],\n",
    "    [8000, 7500, 9000],\n",
    "    [4500, 5100, 4800],\n",
    "    [9000, 8500, 9500]\n",
    ]\n",
    "# a. Calculate the total steps recorded\n",
    "total_steps = np.sum(steps)\n",
    "print(\"a. Total steps recorded:\", total_steps)\n",
    "\n",
    "# b. Calculate the mean number of steps\n",
    "mean_steps = np.mean(steps)\n",
    "print(\"b. Mean number of steps:\", mean_steps)\n",
    "\n",
    "# c. Find the maximum and minimum values\n",
    "max_steps = np.max(steps)\n",
    "min_steps = np.min(steps)\n",
    "print(f\"c. Maximum steps: {max_steps}, Minimum steps: {min_steps}\")\n",
    "\n",
    "# d. Calculate the total steps for each day using axis=0\n",
    "total_steps_per_day = np.sum(steps, axis=0)\n",
    "print(\"d. Total steps for each day (axis=0):\", total_steps_per_day)\n",
    "\n",
    "# e. Calculate the total steps for each user using axis=1\n",
    "total_steps_per_user = np.sum(steps, axis=1)\n",
    "print(\"e. Total steps for each user (axis=1):\", total_steps_per_user)\n",
    "\n",
    "# f. Find the user/day position containing the maximum number of steps using argmax()\n",
    "max_flat_index = np.argmax(steps)\n",
    "max_position = np.unravel_index(max_flat_index, steps.shape)\n",
    "print(\"f. Position of maximum steps (user, day):\", max_position)"}
  ,
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q3. Write a Python program using NumPy to perform the following operations:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# a. Create the original NumPy array\n",
    "original = np.array([1, 2, 3, 4, 5, 6])[cite: 3]\n",
    "print(\"a. Original array:\", original)\n",
    "\n",
    "# b. Create a slice containing elements from index 1 to 4 and store it in subset\n",
    "subset = original[1:5]\n",
    "print(\"b. Subset (index 1 to 4):\", subset)\n",
    "\n",
    "# c. Modify the first element of subset to 999 and display both original and subset\n",
    "subset[0] = 999\n",
    "print(\"c. After modifying subset[0] to 999:\")\n",
    "print(\"   - Original:\", original)\n",
    "print(\"   - Subset:\", subset)\n",
    "\n",
    "# d. Create another slice from original using .copy(), modify its first element to 500, and display both\n",
    "original = np.array([1, 2, 3, 4, 5, 6])[cite: 3]\n",
    "copied_array = original[1:5].copy()\n",
    "copied_array[0] = 500\n",
    "print(\"d. After using .copy() and modifying copied_array[0] to 500:\")\n",
    "print(\"   - Original:\", original)\n",
    "print(\"   - Copied array:\", copied_array)\n",
    "\n",
    "# e. Create a NumPy array containing numbers from 1 to 12 using np.arange() and reshape into a 3x4 matrix\n",
    "matrix_3x4 = np.arange(1, 13).reshape(3, 4)\n",
    "print(\"e. 3x4 Matrix:\\n\", matrix_3x4)\n",
    "\n",
    "# f. Extract specific rows, columns, and sub-matrices using indexing and slicing\n",
    "first_row = matrix_3x4[0, :]\n",
    "last_row = matrix_3x4[-1, :]\n",
    "second_col = matrix_3x4[:, 1]\n",
    "sub_matrix = matrix_3x4[0:2, 1:3]\n",
    "print(\"f. First row:\", first_row)\n",
    "print(\"   Last row:\", last_row)\n",
    "print(\"   Second column:\", second_col)\n",
    "print(\"   Elements from rows 1-2 and columns 2-3:\\n\", sub_matrix)\n",
    "\n",
    "# g. Create a flattened version using flatten() and ravel()\n",
    "flat_flatten = matrix_3x4.flatten()\n",
    "flat_ravel = matrix_3x4.ravel()\n",
    "print(\"g. Flattened (flatten):\", flat_flatten)\n",
    "print(\"   Flattened (ravel):\", flat_ravel)\n",
    "\n",
    "# h. Modify an element in the array returned by ravel() and observe original\n",
    "flat_ravel[0] = 777\n",
    "print(\"h. After modifying ravel() array, original array is affected:\\n\", matrix_3x4)\n",
    "matrix_3x4 = np.arange(1, 13).reshape(3, 4)\n",
    "\n",
    "# i. Modify an element in the array returned by flatten() and observe original\n",
    "flat_flatten = matrix_3x4.flatten()\n",
    "flat_flatten[0] = 888\n",
    "print(\"i. After modifying flatten() array, original array is NOT affected:\\n\", matrix_3x4)\n",
    "\n",
    "# j. Display shape, ndim, size, and dtype of the 3x4 matrix\n",
    "matrix_3x4 = np.arange(1, 13).reshape(3, 4)\n",
    "print(\"j. Attributes of 3x4 matrix:\")\n",
    "print(\"   - Shape:\", matrix_3x4.shape)\n",
    "print(\"   - Dimensions (ndim):\", matrix_3x4.ndim)\n",
    "print(\"   - Size:\", matrix_3x4.size)\n",
    "print(\"   - Data type (dtype):\", matrix_3x4.dtype)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q4. A simple cognitive-assistive system wants to predict a user's assistance score based on three factors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X = np.array([\n",
    "    [6, 70, 3],\n",
    "    [5, 50, 6],\n",
    "    [8, 80, 2],\n",
    "    [4, 30, 8]\n",
    "])[cite: 4]\n",
    "y = np.array([40, 65, 30, 85])[cite: 4]\n",
    "\n",
    "# a. Display the shape and dimensions of X\n",
    "print(\"a. Shape of X:\", X.shape)\n",
    "print(\"   Dimensions of X (ndim):\", X.ndim)\n",
    "\n",
    "# b. Calculate X.T and explain what the transpose represents\n",
    "X_T = X.T\n",
    "print(\"b. Transpose of X (X.T):\\n\", X_T)\n",
    "# Explanation: The transpose flips the matrix over its main diagonal, converting rows into columns[cite: 2].\n",
    "\n",
    "# c. Calculate the matrix product: X.T @ X\n",
    "XT_X = X.T @ X\n",
    "print(\"c. Matrix product X.T @ X:\\n\", XT_X)\n",
    "\n",
    "# d. Calculate the matrix inverse using np.linalg.inv() where appropriate\n",
    "XT_X_inv = np.linalg.inv(XT_X)\n",
    "print(\"d. Inverse of (X.T @ X):\\n\", XT_X_inv)\n",
    "\n",
    "# e. Implement the Ordinary Least Squares equation: beta = (X.T @ X)^-1 @ X.T @ y[cite: 2]\n",
    "beta = np.linalg.inv(X.T @ X) @ X.T @ y\n",
    "print(\"e. Calculated coefficients (beta):\", beta)\n",
    "\n",
    "# f. Explain what the resulting coefficients represent in the context of the three user features\n",
    "# Explanation: Each coefficient represents the expected change in the assistance score \n",
    "# per unit change in the corresponding feature (Sleep hours, Activity level, Stress level)[cite: 2].\n",
    "\n",
    "# g. A new user has: new_user = np.array([5, 40, 7]). Use calculated coefficients to obtain predicted assistance score\n",
    "new_user = np.array([5, 40, 7])\n",
    "predicted_score = new_user @ beta\n",
    "print(\"g. Predicted assistance score for new user:\", predicted_score)"
   ]
  }
