#Q6

def score_hypothesis_with_ties(query, df):
    query_words = set(query.lower().split())
    scores = []
    
    for idx, row in df.iterrows():
        kw_set = set(row['keywords'].lower().split())
        # Score calculated from keyword overlap
        score = len(query_words.intersection(kw_set))
        scores.append(score)
        
    result_df = df.copy()
    result_df['score'] = scores
    
    max_score = result_df['score'].max()
    if max_score == 0:
        print("No matching entries found.")
        return pd.DataFrame()
        
    top_matches = result_df[result_df['score'] == max_score]
    
    if len(top_matches) > 1:
        print(f"Tie detected for query: '{query}' ({len(top_matches)} entries with top score {max_score}):")
    else:
        print(f"Single top match for query: '{query}' (score {max_score}):")
        
    return top_matches[['question', 'answer', 'keywords', 'category', 'score']]

# Demonstration 1: Query producing a TIE (matches "fee" in multiple billing entries)
print("=== Demonstration 1: Query with Tie ===")
print(score_hypothesis_with_ties("fee", df))

print("\n" + "="*40 + "\n")

# Demonstration 2: Query WITHOUT a tie
print("=== Demonstration 2: Query without Tie ===")
print(score_hypothesis_with_ties("reset password", df))