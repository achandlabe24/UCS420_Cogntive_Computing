def score_hypothesis(query, df):
    query_words = set(query.lower().split())
    scores = []
    
    for idx, row in df.iterrows():
        kw_set = set(row['keywords'].lower().split())
        q_set = set(row['question'].lower().split())
        # Score based on keyword matches + question term matches
        score = len(query_words.intersection(kw_set)) * 2 + len(query_words.intersection(q_set))
        scores.append(score)
    
    result_df = df.copy()
    result_df['score'] = scores
    # Filter matching entries (score > 0) and sort by confidence score descending
    ranked_results = result_df[result_df['score'] > 0].sort_values(by='score', ascending=False)
    return ranked_results

# Example usage
